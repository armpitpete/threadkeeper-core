{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:threadkeeper:schema:exclusive-governed-record-event:v1",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "occurred_at",
    "actor",
    "expected_ledger_commit",
    "authority_policy_version",
    "targets",
    "source_versions",
    "record_kind",
    "prior_state",
    "resulting_state",
    "reason",
    "idempotency_key",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "urn:threadkeeper:schema:exclusive-governed-record-event:v1"
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "enum": [
        "core.record.created",
        "core.record.replaced",
        "core.record.revoked"
      ]
    },
    "occurred_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "actor": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "expected_ledger_commit": {
      "type": "string",
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "authority_policy_version": {
      "type": "string",
      "minLength": 1
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "source_versions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "record_kind": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "value": {},
    "prior_state": {
      "type": "object"
    },
    "resulting_state": {
      "type": "object"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {"const": "core.record.revoked"}
        },
        "required": ["event_type"]
      },
      "then": {
        "not": {"required": ["value"]}
      },
      "else": {
        "required": ["value"]
      }
    }
  ],
  "additionalProperties": false
}
