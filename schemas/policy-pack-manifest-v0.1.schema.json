{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:threadkeeper:schema:policy-pack-manifest:v0.1",
  "type": "object",
  "required": [
    "schema_version",
    "pack_id",
    "pack_version",
    "pack_status",
    "domain",
    "authority_effect",
    "core_contract",
    "policy_body",
    "object_kinds",
    "assertions",
    "evidence_requirements",
    "decision_functions"
  ],
  "properties": {
    "schema_version": {
      "const": "urn:threadkeeper:schema:policy-pack-manifest:v0.1"
    },
    "pack_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "pack_version": {
      "type": "string",
      "minLength": 1
    },
    "pack_status": {
      "description": "Source-declared lifecycle metadata only. This field never establishes Threadkeeper registration, activation or authority.",
      "enum": [
        "candidate",
        "published",
        "superseded",
        "withdrawn"
      ]
    },
    "domain": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "authority_effect": {
      "const": "none"
    },
    "core_contract": {
      "const": "threadkeeper.policy-pack/v0.1"
    },
    "policy_body": {
      "type": "object",
      "required": [
        "source_id",
        "exact_source_version_or_digest",
        "object_id_or_path",
        "exact_object_version_or_digest"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "exact_source_version_or_digest": {
          "type": "string",
          "minLength": 1
        },
        "object_id_or_path": {
          "type": "string",
          "minLength": 1
        },
        "exact_object_version_or_digest": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "object_kinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
      }
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "assertion_id",
          "body_ref"
        ],
        "properties": {
          "assertion_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
          },
          "body_ref": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "evidence_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "requirement_id",
          "body_ref",
          "applies_to"
        ],
        "properties": {
          "requirement_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
          },
          "body_ref": {
            "type": "string",
            "minLength": 1
          },
          "applies_to": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "decision_functions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "function_id",
          "evaluation_class"
        ],
        "properties": {
          "function_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
          },
          "evaluation_class": {
            "enum": [
              "DECLARATIVE",
              "DETERMINISTIC",
              "ADVISORY",
              "HUMAN_REQUIRED"
            ]
          },
          "inputs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "outputs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "evidence_roles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
